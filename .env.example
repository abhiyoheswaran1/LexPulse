# LexPulse environment variables.
#
# Local dev (Postgres on your laptop):
#   DATABASE_URL  = postgresql://postgres:postgres@localhost:5432/lexpulse?schema=public
#   DIRECT_URL    = (same as DATABASE_URL — local doesn't use a pooler)
#
# Production (Supabase): use the transaction pooler for runtime, the direct
# connection for migrations. Prisma reads `url` for queries and `directUrl`
# for migrations. Pooler avoids exhausting Postgres connections from
# serverless function instances.

# Runtime — Supabase TRANSACTION POOLER (port 6543)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations — Supabase DIRECT CONNECTION (port 5432)
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Optional — Supabase project URL + anon key (used if/when we add Supabase
# Auth or call PostgREST directly from the client; not needed for v0).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CourtListener API token (optional but recommended for higher rate limits
# during ingest). Register at https://www.courtlistener.com/help/api/rest/
COURTLISTENER_API_TOKEN=
